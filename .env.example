VITE_API_BASE_URL=https://builtright-backend-1.onrender.com

# Keep provider actions disabled until their server-side adapters, sandbox
# credentials, webhook verification, and pilot tests are complete.
VITE_BANK_PROVIDER_ENABLED=false
VITE_BANK_PROVIDER_NAME=Bank provider pending
VITE_ASHGRIDX_ENABLED=false

# Server-side AshGridX pilot settings. Leave disabled until AshGridX supplies
# staging credentials, a webhook secret, and the approved outbound base URL.
ASHGRIDX_ENABLED=false
ASHGRIDX_API_BASE_URL=
ASHGRIDX_API_KEY=
ASHGRIDX_WEBHOOK_SECRET=
ASHGRIDX_WEBHOOK_SIGNATURE_HEADER=x-ashgridx-signature
ASHGRIDX_WEBHOOK_TIMESTAMP_HEADER=x-ashgridx-timestamp

# Optional virtual training resources. Set these on the backend when a live
# class link or downloadable brochure is ready for the active cohort.
TRAINING_LIVE_CLASS_URL=
TRAINING_BROCHURE_URL=
